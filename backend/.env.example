PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=surfsync_studio
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
API_BASE=http://localhost:5000/api
# Use a public HTTPS URL in production / ngrok when testing Meta webhooks
PUBLIC_API_BASE=http://localhost:5000/api/public/leads
APP_BASE=http://localhost:5173

# SurfSync platform Meta App (ONE app for all companies — companies only tap Connect)
META_VERIFY_TOKEN=surfsync_verify
META_APP_ID=
META_APP_SECRET=
# Must match Valid OAuth Redirect URIs in Meta App settings
META_REDIRECT_URI=http://localhost:5000/api/public/leads/facebook/oauth/callback

# One-time Meta Developer Console (SurfSync app):
# 1. Add META_REDIRECT_URI as Valid OAuth Redirect URI
# 2. Page webhook Callback URL = {PUBLIC_API_BASE}/meta/webhook
# 3. Verify token = META_VERIFY_TOKEN
# 4. Subscribe to leadgen
# 5. Permissions: public_profile, pages_show_list, pages_manage_metadata,
#    pages_read_engagement, leads_retrieval, business_management, ads_read, pages_manage_ads
